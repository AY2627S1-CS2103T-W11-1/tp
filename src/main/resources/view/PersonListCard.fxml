<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
    <padding>
      <Insets top="10" right="12" bottom="10" left="15" />
    </padding>
    <HBox spacing="0.5" alignment="TOP_LEFT">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Ensures that the label text is never truncated -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" maxWidth="1.7976931348623157E308" text="\$first"
             styleClass="cell_big_label" wrapText="true" HBox.hgrow="ALWAYS" />
    </HBox>
    <GridPane hgap="10" maxWidth="1.7976931348623157E308">
      <columnConstraints>
        <ColumnConstraints percentWidth="40" hgrow="ALWAYS" />
        <ColumnConstraints percentWidth="60" hgrow="ALWAYS" />
      </columnConstraints>
      <VBox maxWidth="1.7976931348623157E308" spacing="2" GridPane.hgrow="ALWAYS">
        <Label styleClass="person-section-heading" text="Contact" />
        <GridPane hgap="8" vgap="2" maxWidth="1.7976931348623157E308">
          <columnConstraints>
            <ColumnConstraints minWidth="48" prefWidth="48" />
            <ColumnConstraints hgrow="ALWAYS" />
          </columnConstraints>
          <Label styleClass="person-field-label" text="Phone" GridPane.rowIndex="0" />
          <Label fx:id="phone" maxWidth="1.7976931348623157E308" styleClass="person-field-value"
                 text="\$phone" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />
          <Label styleClass="person-field-label" text="Email" GridPane.rowIndex="1" />
          <Label fx:id="email" maxWidth="1.7976931348623157E308" styleClass="person-field-value"
                 text="\$email" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        </GridPane>
      </VBox>
      <VBox maxWidth="1.7976931348623157E308" spacing="2"
            GridPane.columnIndex="1" GridPane.hgrow="ALWAYS">
        <Label styleClass="person-section-heading" text="Cycling Profile" />
        <GridPane hgap="8" vgap="2" maxWidth="1.7976931348623157E308">
          <columnConstraints>
            <ColumnConstraints minWidth="68" prefWidth="68" />
            <ColumnConstraints hgrow="ALWAYS" />
          </columnConstraints>
          <Label styleClass="person-field-label" text="FTP" GridPane.rowIndex="0" />
          <Label fx:id="ftp" styleClass="person-field-value" text="\$ftp"
                 GridPane.columnIndex="1" GridPane.rowIndex="0" />
          <Label styleClass="person-field-label" text="Experience" GridPane.rowIndex="1" />
          <Label fx:id="experienceLevel" styleClass="experience-chip" text="\$experienceLevel"
                 GridPane.columnIndex="1" GridPane.rowIndex="1" />
        </GridPane>
      </VBox>
    </GridPane>
    <GridPane hgap="8" maxWidth="1.7976931348623157E308">
      <columnConstraints>
        <ColumnConstraints minWidth="68" prefWidth="68" />
        <ColumnConstraints hgrow="ALWAYS" />
      </columnConstraints>
      <Label styleClass="person-field-label" text="Locations" />
      <Label fx:id="locations" maxWidth="1.7976931348623157E308" styleClass="person-field-value"
             text="\$locations" wrapText="true" GridPane.columnIndex="1" />
    </GridPane>
  </VBox>
</HBox>
