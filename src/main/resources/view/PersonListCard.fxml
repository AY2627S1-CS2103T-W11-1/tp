<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
    <padding>
      <Insets top="10" right="12" bottom="10" left="15" />
    </padding>
    <HBox spacing="0.5" alignment="TOP_LEFT">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Ensures that the label text is never truncated -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" maxWidth="1.7976931348623157E308" text="\$first"
             styleClass="cell_big_label" wrapText="true" HBox.hgrow="ALWAYS" />
    </HBox>
    <FlowPane hgap="18" vgap="2">
      <HBox alignment="CENTER_LEFT" spacing="6">
        <Label styleClass="person-field-label" text="Phone" />
        <Label fx:id="phone" styleClass="person-field-value" text="\$phone" />
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="6">
        <Label styleClass="person-field-label" text="FTP" />
        <Label fx:id="ftp" styleClass="person-field-value" text="\$ftp" />
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="6">
        <Label styleClass="person-field-label" text="Experience" />
        <Label fx:id="experienceLevel" styleClass="experience-chip" text="\$experienceLevel" />
      </HBox>
    </FlowPane>
    <GridPane hgap="8" vgap="2" maxWidth="1.7976931348623157E308">
      <columnConstraints>
        <ColumnConstraints minWidth="68" prefWidth="68" />
        <ColumnConstraints hgrow="ALWAYS" />
      </columnConstraints>
      <Label styleClass="person-field-label" text="Email" GridPane.rowIndex="0" />
      <Label fx:id="email" maxWidth="1.7976931348623157E308" styleClass="person-field-value"
             text="\$email" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <Label styleClass="person-field-label" text="Locations" GridPane.rowIndex="1" />
      <Label fx:id="locations" maxWidth="1.7976931348623157E308" styleClass="person-field-value"
             text="\$locations" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <Label styleClass="person-field-label" text="Address" GridPane.rowIndex="2" />
      <Label fx:id="address" maxWidth="1.7976931348623157E308" styleClass="person-field-value"
             text="\$address" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>
    <FlowPane fx:id="tags" />
  </VBox>
</HBox>
