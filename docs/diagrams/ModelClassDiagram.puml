@startuml
!include style.puml
!pragma layout smetana
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0

package Model as ModelPackage <<Rectangle>> {
class "<<interface>>\nModel" as Model
class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
class ModelManager
class AddressBook {
    - nextRideId : int
}
show AddressBook fields
class UserPrefs
class UniquePersonList
class Person
class Name
class Phone
class Email
class Ftp
class ExperienceLevel
class Location
class Ride
class "FilteredList<Person>" as FilteredPersons
class "SortedList<Person>" as SortedPersons
}

ModelManager .up.|> Model
AddressBook .up.|> ReadOnlyAddressBook
UserPrefs .up.|> ReadOnlyUserPrefs
Model ..> ReadOnlyAddressBook
Model ..> ReadOnlyUserPrefs
ModelManager --> "1" AddressBook
ModelManager --> "1" UserPrefs
AddressBook *--> "1" UniquePersonList : persons
AddressBook --> "0..*" Ride : rides {ordered}
UniquePersonList --> "0..*" Person : stored cyclists {ordered}

Person --> "1" Name : name
Person --> "1" Phone : phone (own)
Person --> "0..1" Phone : emergencyPhone\nOptional<Phone>
Person --> "1" Email : email
Person --> "1" Ftp : ftp
Person --> "1" ExperienceLevel : experienceLevel
Person --> "0..*" Location : locations {set}

ModelManager --> "1" FilteredPersons : filteredPersons
ModelManager --> "1" SortedPersons : sortedPersons
UniquePersonList ..> FilteredPersons : source via AddressBook\n.getPersonList()
FilteredPersons ..> SortedPersons : source
Model ..> SortedPersons : getFilteredPersonList()\nreturns sorted view

note bottom of SortedPersons
  Alphabetical by full name, ignoring case.
  Ties retain stored order.
  Filtering and sorting leave stored order unchanged.
end note
@enduml
