@startuml
!include style.puml
!pragma layout smetana
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam minClassWidth 110

package Model as ModelPackage <<Rectangle>> {
class "<<interface>>\nModel" as Model
class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
class ModelManager
class AddressBook {
    - nextRideId : int
}
show AddressBook fields
class UserPrefs
class UniquePersonList
class Person
class Name
class Email
class Ftp
class Phone
class ExperienceLevel
class Location
class Ride
class "ObservableList<Person>" as StoredPersons
class "FilteredList<Person>" as FilteredPersons
class "SortedList<Person>" as SortedPersons
}

ModelManager .up.|> Model
AddressBook .up.|> ReadOnlyAddressBook
UserPrefs .up.|> ReadOnlyUserPrefs
Model ..> ReadOnlyAddressBook
Model ..> ReadOnlyUserPrefs
' Label padding keeps multiplicity text clear of arrowheads and line segments.
ModelManager --> "1\n" AddressBook
ModelManager --> "1\n" UserPrefs
AddressBook *--> "1    " UniquePersonList
AddressBook -up-> "rides    \n0..*    " Ride
Ride -[hidden]right-> ReadOnlyAddressBook
UniquePersonList --> Person : \n\ncontains\n0..*

Person --> Name
' Longer links place Phone on a separate row so both roles remain readable.
Person ----> "phone    \n1    " Phone
Person ----> "emergencyPhone    \n0..1    " Phone
Person --> Email
Person --> Ftp
Person --> ExperienceLevel
Person -up-> "locations    \n0..*    " Location
Location -[hidden]right-> UniquePersonList

ModelManager --> "1\n" SortedPersons
UniquePersonList -right-> "1\n" StoredPersons
FilteredPersons -up-> StoredPersons
SortedPersons -up-> FilteredPersons


legend bottom
  Display pipeline: stored view -> filtered view -> sorted view.
  ModelManager.getFilteredPersonList() exposes sortedPersons.
  Own phone is required; emergencyPhone is Optional<Phone>.
endlegend
@enduml
