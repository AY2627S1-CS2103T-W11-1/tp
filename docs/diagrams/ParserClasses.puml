@startuml
!include style.puml
set separator none
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
hide empty members

package "logic.parser" {
    interface Parser
    class AddressBookParser
    class FindCommandParser
    class RideFindCommandParser
    class ParserUtil
    class ArgumentMultimap
    class ArgumentTokenizer
    class Prefix
    class CliSyntax
}

package "logic.commands" {
    abstract class Command
    class FindCommand {
        - predicate : PersonMatchesFindCriteriaPredicate
    }
    class RideFindCommand {
        - predicate : RideMatchesFindCriteriaPredicate
    }
}
show FindCommand fields
show RideFindCommand fields

package "model.person" {
    class PersonMatchesFindCriteriaPredicate MODEL_COLOR
}

package "model.ride" {
    class RideMatchesFindCriteriaPredicate MODEL_COLOR
}

AddressBookParser ..> FindCommandParser : <<create>>
AddressBookParser ..> RideFindCommandParser : <<create>>
Parser <|.. FindCommandParser
Parser <|.. RideFindCommandParser
FindCommandParser .left.> FindCommand : <<create>>
RideFindCommandParser .left.> RideFindCommand : <<create>>
Command <|-- FindCommand
Command <|-- RideFindCommand
FindCommandParser .down.> PersonMatchesFindCriteriaPredicate : <<create>>
RideFindCommandParser .down.> RideMatchesFindCriteriaPredicate : <<create>>

FindCommandParser ..> ArgumentTokenizer
RideFindCommandParser ..> ArgumentTokenizer
ArgumentTokenizer ..> ArgumentMultimap : <<create>>
ArgumentTokenizer ..> Prefix : recognises
FindCommandParser .up.> ParserUtil
RideFindCommandParser .down.> ParserUtil
CliSyntax ..> Prefix : defines

legend bottom
  Both parsers tokenise with ArgumentTokenizer and validate with ParserUtil.
  They read ArgumentMultimap values and use CliSyntax prefixes.
  Only the search-related classes and relationships are shown.
endlegend
@enduml
