@startuml
!include style.puml
set separator none
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
skinparam classAttributeFontColor #FFFFFF
skinparam classAttributeIconSize 0
hide empty members

package "logic.parser" {
    interface Parser <<interface>>
    class AddressBookParser
    class FindCommandParser
    class RideFindCommandParser

    Parser -[hidden]down-> AddressBookParser
    AddressBookParser -[hidden]down-> FindCommandParser
    FindCommandParser -[hidden]right-> RideFindCommandParser
}

package "logic.commands" {
    abstract class Command
    class FindCommand {
        - predicate : PersonMatchesFindCriteriaPredicate
    }
    class RideFindCommand {
        - predicate : RideMatchesFindCriteriaPredicate
    }
}
show FindCommand fields
show RideFindCommand fields

package "model.person" {
    class PersonMatchesFindCriteriaPredicate MODEL_COLOR
}

package "model.ride" {
    class RideMatchesFindCriteriaPredicate MODEL_COLOR
}

AddressBookParser .down.> FindCommandParser : <<create>>
AddressBookParser .down.> RideFindCommandParser : <<create>>
FindCommandParser .up.|> Parser
RideFindCommandParser .up.|> Parser
FindCommandParser .down.> FindCommand : <<create>>
RideFindCommandParser .down.> RideFindCommand : <<create>>
Command <|-- FindCommand
Command <|-- RideFindCommand
FindCommandParser .down.> PersonMatchesFindCriteriaPredicate : <<create>>
RideFindCommandParser .down.> RideMatchesFindCriteriaPredicate : <<create>>

FindCommand -[hidden]down-> RideFindCommand
PersonMatchesFindCriteriaPredicate -[hidden]down-> RideMatchesFindCriteriaPredicate

FindCommand -[hidden]right-> Command
Command -[hidden]right-> RideFindCommand
PersonMatchesFindCriteriaPredicate -[hidden]right-> RideMatchesFindCriteriaPredicate

legend bottom
  Both parsers use ArgumentTokenizer, ArgumentMultimap, Prefix,
  CliSyntax and ParserUtil to parse and validate their inputs.
  Only the main search-related relationships are shown.
endlegend
@enduml
