@startuml
!include style.puml
skinparam ArrowFontStyle plain

actor User as user USER_COLOR
participant ":Ui" as ui UI_COLOR
participant ":Logic" as logic LOGIC_COLOR
participant ":Model" as model MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR

user -> ui : "delete +65 91234567"
activate ui
ui -> logic : execute("delete +65 91234567")
activate logic
logic -> model : getFilteredPersonList()
model --> logic : displayed cyclists
note over logic : Resolve target; store pending\ncommand and cyclist snapshot.
logic --> ui : CommandResult: confirmation prompt
deactivate logic
ui --> user : Ask for y/yes or n/no
deactivate ui
note over model, storage : Requesting confirmation does not change or save data.

user -> ui : "yes"
activate ui
ui -> logic : execute("yes")
activate logic
note over logic : Consume pending request.
logic -> model : getFilteredPersonList()
model --> logic : displayed cyclists
note over logic, model : Revalidate target against snapshot before deletion.\nRepeated lookups within Logic are omitted.
logic -> model : deletePerson(person)
activate model
note right of model : Remove cyclist and their\nphone from ride rosters.
model --> logic
deactivate model
logic -> model : getAddressBook()
model --> logic : addressBook
logic -> storage : saveAddressBook(addressBook)
activate storage
storage --> logic
deactivate storage
logic --> ui : CommandResult: deletion success
deactivate logic
ui --> user : Show deletion success
deactivate ui
@enduml
