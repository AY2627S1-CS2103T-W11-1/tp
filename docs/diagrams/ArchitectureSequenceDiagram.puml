@startuml
!include style.puml
skinparam ArrowFontStyle plain

actor User as user USER_COLOR
participant Ui as ui UI_COLOR
participant Logic as logic LOGIC_COLOR
participant Model as model MODEL_COLOR
participant Storage as storage STORAGE_COLOR

user -> ui : Enter delete +65 91234567
ui -> logic : execute("delete +65 91234567")
activate logic
logic -> model : getFilteredPersonList()
model --> logic : displayed cyclists
note over logic : Resolve target and retain pending request.
logic --> ui : Confirmation prompt
deactivate logic
ui --> user : Display confirmation prompt
note over model, storage : No model change or save at the request stage.

user -> ui : Enter yes
ui -> logic : execute("yes")
activate logic
logic -> model : getFilteredPersonList()
model --> logic : displayed cyclists
note over logic : Consume pending request and revalidate target.\nThe confirmed, unchanged-target path is shown.
logic -> model : deletePerson(person)
model --> logic
logic -> model : getAddressBook()
model --> logic : addressBook
logic -> storage : saveAddressBook(addressBook)
activate storage
storage --> logic
deactivate storage
logic --> ui : Deletion success
deactivate logic
ui --> user : Display deletion success

legend bottom
  Lifelines represent components; internal object calls are omitted.
  Solid arrows show requests; dashed arrows show responses.
endlegend
@enduml
